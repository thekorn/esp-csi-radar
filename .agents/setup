#!/usr/bin/env bash
set -euo pipefail

time_step() {
  local label="$1"
  shift
  local start=$SECONDS
  echo "[setup] $label"
  "$@"
  echo "[setup] $label completed in $((SECONDS - start))s"
}

install_nix() {
  if ! dpkg-query -W -f='${Status}' nix-bin 2>/dev/null | grep -Fq 'install ok installed'; then
    sudo apt-get update
    sudo DEBIAN_FRONTEND=noninteractive apt-get install -y nix-bin
  fi

  if ! /nix/var/nix/profiles/default/bin/nix --version >/dev/null 2>&1; then
    echo "[setup] Installing a current Nix in the system profile"
    sudo nix upgrade-nix -p /nix/var/nix/profiles/default
  fi
  sudo ln -sfn /nix/var/nix/profiles/default/bin/nix /usr/local/bin/nix
  hash -r
}

time_step "Ensuring Nix is installed" install_nix

nix_features="extra-experimental-features = nix-command flakes"
if ! grep -Fqx "$nix_features" /etc/nix/nix.conf; then
  printf '\n%s\n' "$nix_features" | sudo tee -a /etc/nix/nix.conf >/dev/null
fi

sudo systemctl enable --now nix-daemon.socket
sudo chmod 0711 /nix/var/nix/daemon-socket

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
nix --version
nix store info
# The setup shell contains every build and test dependency without the
# editor-only language servers. Installing through it realizes the shell too,
# so a separate `nix develop --command true` only repeats flake activation.
time_step "Preparing the development environment and pnpm dependencies" \
  nix develop "path:$repo_root#setup" --command pnpm install --frozen-lockfile

profile_marker="# esp-csi-radar Nix development shell"
if grep -Fqx "$profile_marker" "$HOME/.bash_profile" 2>/dev/null; then
  sed -i "/^$profile_marker$/,/^fi$/d" "$HOME/.bash_profile"
fi
cat >> "$HOME/.bash_profile" <<EOF

$profile_marker
if [[ -z "\${IN_NIX_SHELL:-}" &&
      -z "\${AMP_PORTAL_PROXY_SOURCE:-}" &&
      "\${PWD}" == "$repo_root" ]]; then
  eval "\$(nix print-dev-env 'path:$repo_root#setup')"
fi
EOF

echo "[setup] Complete"
