{
  "name": "esp-csi-radar",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt host web package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "oxfmt --check host web package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "lint": "oxlint host web --deny-warnings",
    "start:reference": "node host/server.ts",
    "test": "node --test host/tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "serialport": "^13.0.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/ws": "^8.18.1",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "typescript": "^7"
  },
  "engines": {
    "node": ">=26 <27",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.22.0"
}
