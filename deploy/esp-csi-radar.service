[Unit]
Description=ESP32 CSI room radar
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/esp-csi-radar
ExecStart=/run/current-system/sw/bin/nix develop path:.#setup --command zig build run-host -- --socket
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
